{
  "name": "@ecommerce/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src tests scripts --config ../../eslint.config.mjs --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate:stage4": "node scripts/validate-stage4.mjs",
    "validate:stage5": "node scripts/validate-stage5.mjs",
    "validate:stage6": "node scripts/validate-stage6.mjs",
    "validate:stage7": "node scripts/validate-stage7.mjs",
    "validate:stage8": "node scripts/validate-stage8.mjs",
    "validate:stage9": "node scripts/validate-stage9.mjs",
    "validate:stage10": "node scripts/validate-stage10.mjs",
    "validate:stage13": "node scripts/validate-stage13.mjs"
  },
  "dependencies": {
    "@ecommerce/auth": "workspace:*",
    "@ecommerce/catalog": "workspace:*",
    "@ecommerce/commerce": "workspace:*",
    "@ecommerce/config": "workspace:*",
    "@ecommerce/contracts": "workspace:*",
    "@ecommerce/database": "workspace:*",
    "@ecommerce/media": "workspace:*",
    "@ecommerce/observability": "workspace:*",
    "@ecommerce/payments": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "bullmq": "6.3.12",
    "fastify": "5.11.3",
    "reflect-metadata": "0.2.2",
    "redis": "6.3.0",
    "rxjs": "7.8.2",
    "zod": "4.6.6"
  },
  "devDependencies": { "@nestjs/testing": "11.2.7" }
}
