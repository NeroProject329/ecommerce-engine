NODE_ENV=development
LOG_LEVEL=info
STOREFRONT_PORT=3000
ADMIN_PORT=3001
API_PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_STORE_SLUG=demo-store
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_engine?schema=public
REDIS_URL=redis://localhost:6379
AUTH_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_ROOT=.data/media
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=replace-with-bucket-name
R2_ACCESS_KEY_ID=replace-with-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-secret-access-key
R2_PUBLIC_BASE_URL=https://media.example.com
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-secret
EMAIL_PROVIDER=disabled
EMAIL_FROM=no-reply@example.com
EMAIL_API_KEY=replace-with-provider-api-key
STORE_CURRENCY=BRL
STORE_COUNTRY=BR
STORE_LOCALE=pt-BR
STORE_TIMEZONE=America/Sao_Paulo
