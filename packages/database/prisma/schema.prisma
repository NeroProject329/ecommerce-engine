generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StoreStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum DomainStatus {
  PENDING
  VERIFIED
  DISABLED
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductPublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductSourceMode {
  MANUAL
  IMPORTED
  HYBRID
}

enum VariantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum AccountStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
  ANONYMIZED
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  OPTION
  MULTI_OPTION
}

enum MediaProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum MediaRole {
  PRIMARY
  GALLERY
  THUMBNAIL
  SWATCH
}

enum InventoryReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum PromotionTargetType {
  STORE
  CATEGORY
  PRODUCT
  VARIANT
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum CheckoutStatus {
  OPEN
  SUBMITTED
  COMPLETED
  EXPIRED
  FAILED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLING
  SHIPPED
  DELIVERED
  CANCELED
  PAYMENT_FAILED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum ShipmentStatus {
  PENDING
  READY
  SHIPPED
  DELIVERED
  CANCELED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum WebhookSignatureState {
  VALID
  INVALID
  NOT_CHECKED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
}

enum IntegrationStatus {
  ACTIVE
  DISABLED
  ROTATING
}

enum ImportBatchStatus {
  RECEIVED
  QUEUED
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  RETRYING
}

enum ImportItemStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

enum OverridePolicy {
  MANUAL_WINS
  IMPORT_WINS
  REVIEW_REQUIRED
}

enum ContentStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Store {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique @db.VarChar(120)
  displayName String        @db.VarChar(160)
  status      StoreStatus   @default(ACTIVE)
  currency    String        @default("BRL") @db.Char(3)
  timezone    String        @default("America/Sao_Paulo") @db.VarChar(80)
  settings    Json          @default("{}")
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  domains     StoreDomain[]
  brands      Brand[]
  categories  Category[]
  products    Product[]
  variants    ProductVariant[]
  productCategories ProductCategory[]
  inventoryLocations InventoryLocation[]
  inventory   Inventory[]
  prices      Price[]
  outboxEvents OutboxEvent[]
  roles       Role[]
  adminMemberships AdminMembership[]
  customers   Customer[]
  customerSessions CustomerSession[]
  addresses   Address[]
  attributeDefinitions AttributeDefinition[]
  categoryAttributes CategoryAttribute[]
  productAttributeValues ProductAttributeValue[]
  variantAttributeValues VariantAttributeValue[]
  mediaAssets MediaAsset[]
  productMedia ProductMedia[]
  variantMedia VariantMedia[]
  inventoryReservations InventoryReservation[]
  inventoryMovements InventoryMovement[]
  priceHistory PriceHistory[]
  promotions Promotion[]
  promotionTargets PromotionTarget[]
  coupons Coupon[]
  couponRedemptions CouponRedemption[]
  carts Cart[]
  cartItems CartItem[]
  shippingQuotes ShippingQuote[]
  checkoutSessions CheckoutSession[]
  orders Order[]
  orderItems OrderItem[]
  orderStatusHistory OrderStatusHistory[]
  shipments Shipment[]
  payments Payment[]
  paymentAttempts PaymentAttempt[]
  paymentWebhookEvents PaymentWebhookEvent[]
  refunds Refund[]
  integrationClients IntegrationClient[]
  importSources ImportSource[]
  importBatches ImportBatch[]
  importItems ImportItem[]
  importFieldOverrides ImportFieldOverride[]
  externalIdentities ExternalIdentity[]
  idempotencyRecords IdempotencyRecord[]
  auditLogs AuditLog[]
  consentRecords ConsentRecord[]
  storefrontBanners StorefrontBanner[]
  storefrontSections StorefrontSection[]

  @@index([status, createdAt])
  @@map("stores")
}

model StoreDomain {
  id         String       @id @default(uuid()) @db.Uuid
  storeId    String       @db.Uuid
  hostname   String       @unique @db.VarChar(253)
  status     DomainStatus @default(PENDING)
  isPrimary  Boolean      @default(false)
  verifiedAt DateTime?    @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId, status])
  @@map("store_domains")
}

model Brand {
  id        String        @id @default(uuid()) @db.Uuid
  storeId   String        @db.Uuid
  slug      String        @db.VarChar(140)
  name      String        @db.VarChar(160)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  products  Product[]

  @@unique([storeId, slug])
  @@unique([id, storeId])
  @@index([storeId, status, name])
  @@map("brands")
}

model Category {
  id              String        @id @default(uuid()) @db.Uuid
  storeId         String        @db.Uuid
  parentId        String?       @db.Uuid
  slug            String        @db.VarChar(140)
  name            String        @db.VarChar(160)
  path            String        @db.VarChar(1000)
  position        Int           @default(0)
  status          CatalogStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  parent          Category?     @relation("CategoryTree", fields: [parentId, storeId], references: [id, storeId], onDelete: Restrict)
  children        Category[]    @relation("CategoryTree")
  primaryProducts Product[]     @relation("PrimaryCategory")
  productLinks    ProductCategory[]
  attributeRules  CategoryAttribute[]

  @@unique([storeId, slug])
  @@unique([id, storeId])
  @@index([storeId, parentId, position])
  @@index([storeId, status, path])
  @@map("categories")
}

model Product {
  id                String                   @id @default(uuid()) @db.Uuid
  storeId           String                   @db.Uuid
  brandId           String?                  @db.Uuid
  primaryCategoryId String                   @db.Uuid
  slug              String                   @db.VarChar(180)
  title             String                   @db.VarChar(240)
  description       String                   @default("") @db.Text
  seo               Json                     @default("{}")
  publicationStatus ProductPublicationStatus @default(DRAFT)
  sourceMode        ProductSourceMode        @default(MANUAL)
  publishedAt       DateTime?                @db.Timestamptz(3)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(3)
  store             Store                    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  brand             Brand?                   @relation(fields: [brandId, storeId], references: [id, storeId], onDelete: Restrict)
  primaryCategory   Category                 @relation("PrimaryCategory", fields: [primaryCategoryId, storeId], references: [id, storeId], onDelete: Restrict)
  categories        ProductCategory[]
  variants          ProductVariant[]
  attributeValues   ProductAttributeValue[]
  media             ProductMedia[]
  importFieldOverrides ImportFieldOverride[]
  externalIdentities ExternalIdentity[]

  @@unique([storeId, slug])
  @@unique([id, storeId])
  @@index([storeId, publicationStatus, createdAt, id])
  @@index([storeId, primaryCategoryId, id])
  @@index([storeId, brandId, id])
  @@map("products")
}

model ProductCategory {
  storeId   String   @db.Uuid
  productId String   @db.Uuid
  categoryId String  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product   Product  @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  category  Category @relation(fields: [categoryId, storeId], references: [id, storeId], onDelete: Restrict)

  @@id([storeId, productId, categoryId])
  @@index([storeId, categoryId, productId])
  @@map("product_categories")
}

model ProductVariant {
  id                String        @id @default(uuid()) @db.Uuid
  storeId           String        @db.Uuid
  productId         String        @db.Uuid
  sku               String?       @db.VarChar(120)
  externalKey       String?       @db.VarChar(180)
  ean               String?       @db.VarChar(14)
  variantAttributes Json          @default("{}")
  weightGrams       Int?
  lengthMm          Int?
  widthMm           Int?
  heightMm          Int?
  status            VariantStatus @default(ACTIVE)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  store             Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product           Product       @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  inventory         Inventory[]
  prices            Price[]
  attributeValues   VariantAttributeValue[]
  media             VariantMedia[]
  reservations      InventoryReservation[]
  movements         InventoryMovement[]
  priceHistory      PriceHistory[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  externalIdentities ExternalIdentity[]

  @@unique([storeId, sku])
  @@unique([id, storeId])
  @@index([storeId, productId, status])
  @@map("product_variants")
}

model InventoryLocation {
  id        String      @id @default(uuid()) @db.Uuid
  storeId   String      @db.Uuid
  code      String      @db.VarChar(80)
  name      String      @db.VarChar(160)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)
  store     Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  inventory Inventory[]
  movements InventoryMovement[]

  @@unique([storeId, code])
  @@unique([id, storeId])
  @@index([storeId, active, name])
  @@map("inventory_locations")
}

model Inventory {
  id         String            @id @default(uuid()) @db.Uuid
  storeId    String            @db.Uuid
  variantId  String            @db.Uuid
  locationId String            @db.Uuid
  onHand     Int               @default(0)
  reserved   Int               @default(0)
  version    Int               @default(1)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)
  store      Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variant    ProductVariant    @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict)
  location   InventoryLocation @relation(fields: [locationId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([storeId, variantId, locationId])
  @@index([storeId, locationId, variantId])
  @@map("inventory")
}

model Price {
  id             String         @id @default(uuid()) @db.Uuid
  storeId        String         @db.Uuid
  variantId      String         @db.Uuid
  currency       String         @default("BRL") @db.Char(3)
  amountCents    BigInt
  compareAtCents BigInt?
  validFrom      DateTime?      @db.Timestamptz(3)
  validTo        DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variant        ProductVariant @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict)

  @@index([storeId, variantId, currency, validFrom])
  @@map("prices")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  storeId       String?      @db.Uuid
  aggregateType String       @db.VarChar(120)
  aggregateId   String       @db.VarChar(180)
  eventType     String       @db.VarChar(180)
  eventVersion  Int          @default(1)
  payloadJson   Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @db.Timestamptz(3)
  publishedAt   DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  store         Store?       @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([status, availableAt, id])
  @@index([storeId, aggregateType, aggregateId])
  @@map("outbox_events")
}

model AdminUser {
  id              String        @id @default(uuid()) @db.Uuid
  emailNormalized String        @unique @db.VarChar(320)
  passwordHash    String        @db.VarChar(255)
  status          AccountStatus @default(INVITED)
  mfaState        Json          @default("{}")
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  memberships     AdminMembership[]
  sessions        AdminSession[]
  recoveryTokens  AdminRecoveryToken[]

  @@index([status, createdAt])
  @@map("admin_users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  storeId     String?          @db.Uuid
  name        String           @db.VarChar(120)
  immutable   Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  store       Store?           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  memberships AdminMembership[]

  @@unique([storeId, name])
  @@index([storeId, name])
  @@map("roles")
}

model RolePermission {
  roleId         String   @db.Uuid
  permissionCode String   @db.VarChar(160)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  role           Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@index([permissionCode, roleId])
  @@map("role_permissions")
}

model AdminMembership {
  id          String           @id @default(uuid()) @db.Uuid
  storeId     String           @db.Uuid
  adminUserId String           @db.Uuid
  roleId      String           @db.Uuid
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  adminUser   AdminUser        @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  role        Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([storeId, adminUserId, roleId])
  @@index([adminUserId, status])
  @@index([storeId, status])
  @@map("admin_memberships")
}

model AdminSession {
  id            String    @id @default(uuid()) @db.Uuid
  adminUserId   String    @db.Uuid
  tokenHash     String    @unique @db.VarChar(255)
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  mfaVerifiedAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  adminUser     AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
  @@map("admin_sessions")
}

model AdminRecoveryToken {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @db.Uuid
  tokenHash   String    @unique @db.VarChar(255)
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
  @@map("admin_recovery_tokens")
}

model Customer {
  id              String         @id @default(uuid()) @db.Uuid
  storeId         String         @db.Uuid
  emailNormalized String         @db.VarChar(320)
  name            String         @db.VarChar(180)
  status          CustomerStatus @default(ACTIVE)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  credential      CustomerCredential?
  sessions        CustomerSession[]
  addresses       Address[]
  carts           Cart[]
  checkoutSessions CheckoutSession[]
  orders          Order[]
  couponRedemptions CouponRedemption[]
  consentRecords ConsentRecord[]

  @@unique([storeId, emailNormalized])
  @@unique([id, storeId])
  @@index([storeId, status, createdAt])
  @@map("customers")
}

model CustomerCredential {
  customerId       String    @id @db.Uuid
  passwordHash     String    @db.VarChar(255)
  verifiedAt       DateTime? @db.Timestamptz(3)
  resetTokenHash   String?   @unique @db.VarChar(255)
  resetExpiresAt   DateTime? @db.Timestamptz(3)
  passwordChangedAt DateTime @default(now()) @db.Timestamptz(3)
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_credentials")
}

model CustomerSession {
  id         String    @id @default(uuid()) @db.Uuid
  storeId    String    @db.Uuid
  customerId String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(255)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer   Customer  @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Cascade)

  @@index([storeId, customerId, expiresAt])
  @@map("customer_sessions")
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  storeId    String   @db.Uuid
  customerId String   @db.Uuid
  recipient  String   @db.VarChar(180)
  postalCode String   @db.VarChar(12)
  street     String   @db.VarChar(220)
  number     String   @db.VarChar(40)
  complement String?  @db.VarChar(120)
  district   String   @db.VarChar(120)
  city       String   @db.VarChar(120)
  state      String   @db.Char(2)
  country    String   @default("BR") @db.Char(2)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer   Customer @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Cascade)

  @@index([storeId, customerId, isDefault])
  @@map("addresses")
}

model AttributeDefinition {
  id            String                @id @default(uuid()) @db.Uuid
  storeId       String                @db.Uuid
  code          String                @db.VarChar(100)
  name          String                @db.VarChar(160)
  dataType      AttributeDataType
  unit          String?               @db.VarChar(40)
  optionsJson   Json                  @default("[]")
  version       Int                   @default(1)
  active        Boolean               @default(true)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)
  store         Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  categoryRules CategoryAttribute[]
  productValues ProductAttributeValue[]
  variantValues VariantAttributeValue[]

  @@unique([storeId, code])
  @@unique([id, storeId])
  @@index([storeId, active, name])
  @@map("attribute_definitions")
}

model CategoryAttribute {
  storeId     String              @db.Uuid
  categoryId  String              @db.Uuid
  definitionId String             @db.Uuid
  required    Boolean             @default(false)
  filterable  Boolean             @default(false)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category    Category            @relation(fields: [categoryId, storeId], references: [id, storeId], onDelete: Cascade)
  definition  AttributeDefinition @relation(fields: [definitionId, storeId], references: [id, storeId], onDelete: Restrict)

  @@id([storeId, categoryId, definitionId])
  @@index([storeId, definitionId, categoryId])
  @@map("category_attributes")
}

model ProductAttributeValue {
  storeId     String              @db.Uuid
  productId   String              @db.Uuid
  definitionId String             @db.Uuid
  valueJson   Json
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product     Product             @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  definition  AttributeDefinition @relation(fields: [definitionId, storeId], references: [id, storeId], onDelete: Restrict)

  @@id([storeId, productId, definitionId])
  @@index([storeId, definitionId, productId])
  @@map("product_attribute_values")
}

model VariantAttributeValue {
  storeId     String              @db.Uuid
  variantId   String              @db.Uuid
  definitionId String             @db.Uuid
  valueJson   Json
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variant     ProductVariant      @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Cascade)
  definition  AttributeDefinition @relation(fields: [definitionId, storeId], references: [id, storeId], onDelete: Restrict)

  @@id([storeId, variantId, definitionId])
  @@index([storeId, definitionId, variantId])
  @@map("variant_attribute_values")
}

model MediaAsset {
  id               String                @id @default(uuid()) @db.Uuid
  storeId          String                @db.Uuid
  storageKey       String                @db.VarChar(1024)
  sha256           String                @db.Char(64)
  mimeType         String                @db.VarChar(120)
  bytes            BigInt
  width            Int?
  height           Int?
  durationMs       Int?
  processingStatus MediaProcessingStatus @default(PENDING)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)
  store            Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  renditions       MediaRendition[]
  products         ProductMedia[]
  variants         VariantMedia[]
  storefrontBanners StorefrontBanner[]

  @@unique([storeId, storageKey])
  @@unique([storeId, sha256])
  @@unique([id, storeId])
  @@index([storeId, processingStatus, createdAt])
  @@map("media_assets")
}

model MediaRendition {
  id           String     @id @default(uuid()) @db.Uuid
  storeId      String     @db.Uuid
  mediaAssetId String     @db.Uuid
  format       String     @db.VarChar(20)
  width        Int
  height       Int
  storageKey   String     @db.VarChar(1024)
  bytes        BigInt
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
